<?php
/**
 * 集成测试配置文件示例
 * 
 * 复制此文件为 config.local.php 并填入实际的 RabbitMQ 和 Redis 连接信息
 * config.local.php 文件会被 .gitignore 忽略，不会提交到版本库
 * 
 * 使用方法：
 * 1. 复制此文件：cp tests/config.local.php.example tests/config.local.php
 * 2. 编辑 tests/config.local.php，填入实际的连接信息
 * 3. 运行测试：php vendor/bin/phpunit tests/
 */

return [
    'rabbitmq' => [
        'host' => 'localhost',
        'port' => 5672,
        'user' => 'guest',
        'password' => 'guest',
        'vhost' => '/',
    ],
    'redis' => [
        'host' => 'localhost',
        'port' => 6379,
        'database' => 0,
        'password' => null, // 如果没有密码，设置为 null
    ],
];

